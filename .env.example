# Hosted PostgreSQL pooled connection URL, using TLS
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Generate independent secrets; never commit real values.
APP_API_KEY=
TOKEN_ENCRYPTION_KEY=
# Google OAuth client type MUST be Web application (not Desktop).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-DEPLOYMENT/auth/google/callback
GEMINI_API_KEY=
